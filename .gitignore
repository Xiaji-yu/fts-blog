config.json
deploy_config.py

# Local npm cache used by offline installs
.npm-cache/

# Test artifacts
test/.tmp/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/
