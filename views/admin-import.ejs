<script>
// Escape values before interpolating into innerHTML (filenames come from disk).
function esc(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (m) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
  });
}

const dropZone = document.getElementById('dropZone');
const fileInput = document.getElementById('fileInput');
const fileList = document.getElementById('fileList');
const importBtn = document.getElementById('importBtn');
const statusDiv = document.getElementById('importStatus');
let selectedFiles = [];

dropZone.addEventListener('click', () => fileInput.click());
fileInput.addEventListener('change', (e) => handleFiles(Array.from(e.target.files)));
dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', (e) => {
  e.preventDefault();
  dropZone.classList.remove('dragover');
  handleFiles(Array.from(e.dataTransfer.files));
});

function handleFiles(files) {
  selectedFiles = files.filter(f => f.name.endsWith('.md'));
  if (selectedFiles.length === 0) {
    fileList.innerHTML = '<p style="color: var(--accent);">请选择 .md 文件</p>';
    importBtn.disabled = true;
    return;
  }
  fileList.innerHTML = selectedFiles.map(f =>
    `<div style="padding: 0.5rem 0; font-family: var(--font-mono); font-size: 0.85rem; color: var(--fg-dim);">📄 ${f.name}</div>`
  ).join('');
  importBtn.disabled = false;
}

function readFileAsText(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = (e) => resolve(e.target.result);
    reader.onerror = reject;
    reader.readAsText(file);
  });
}

function parseFrontmatter(content) {
  const lines = content.split('\n');

  // First line must be exactly ---
  if (lines[0].trim() !== '---') {
    return { frontmatter: {}, content: content };
  }

  // Find closing --- on its own line
  let endIndex = -1;
  for (let i = 1; i < lines.length; i++) {
    if (/^---\s*$/.test(lines[i])) {
      endIndex = i;
      break;
    }
  }

  if (endIndex === -1) {
    return { frontmatter: {}, content: content };
  }

  const frontmatterText = lines.slice(1, endIndex).join('\n').trim();
  const markdownContent = lines.slice(endIndex + 1).join('\n');

  // Simple YAML key:value parser
  const frontmatter = {};
  const fmLines = frontmatterText.split('\n');
  let currentKey = null;

  for (const line of fmLines) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;

    const kvMatch = trimmed.match(/^([^\s:]+):\s*(.+)?$/);
    if (kvMatch) {
      const key = kvMatch[1];
      const rawValue = kvMatch[2] ? kvMatch[2].trim() : '';

      if (rawValue.startsWith('[') && rawValue.endsWith(']')) {
        frontmatter[key] = rawValue.slice(1, -1).split(',').map(v => v.trim()).filter(v => v);
        currentKey = null;
      } else if ((rawValue.startsWith('"') && rawValue.endsWith('"')) || (rawValue.startsWith("'") && rawValue.endsWith("'"))) {
        frontmatter[key] = rawValue.slice(1, -1);
        currentKey = null;
      } else {
        frontmatter[key] = rawValue;
        currentKey = key;
      }
    } else if (trimmed.startsWith('- ') && currentKey) {
      const item = trimmed.slice(2).trim();
      if (!Array.isArray(frontmatter[currentKey])) {
        frontmatter[currentKey] = [];
      }
      frontmatter[currentKey].push(item);
    }
  }

  return { frontmatter, content: markdownContent };
}

function convertObsidianSyntax(content) {
  const lines = content.split('\n');
  const result = [];
  let inCallout = false;
  let calloutLines = [];

  const iconMap = {
    'note': 'ℹ️', 'info': 'ℹ️',
    'warning': '⚠️', 'danger': '🚨',
    'tip': '💡', 'important': '❗',
    'question': '❓'
  };

  // Browser-compatible extname (no Node.js path module)
  function getExt(filename) {
    const dotIdx = filename.lastIndexOf('.');
    return dotIdx >= 0 ? filename.slice(dotIdx).toLowerCase() : '';
  }

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const calloutMatch = line.match(/^>\s*\[!(\w+)\]\s*(.*)$/);

    if (calloutMatch) {
      inCallout = true;
      const type = calloutMatch[1].toUpperCase();
      const icon = iconMap[calloutMatch[1].toLowerCase()] || '📝';
      const firstText = calloutMatch[2].trim();
      calloutLines = firstText ? [`> ${icon} **${type}** ${firstText}`] : [`> ${icon} **${type}**`];
      continue;
    }

    if (inCallout) {
      if (line.startsWith('>') || line.trim() === '') {
        calloutLines.push(line.trim() === '' ? '>' : line);
        continue;
      } else {
        inCallout = false;
        result.push(...calloutLines);
        result.push('');
        calloutLines = [];
      }
    }

    // Table row: escape pipes inside cells
    const trimmed = line.trim();
    const isTableRow = trimmed.startsWith('|') && trimmed.endsWith('|');
    const isTableSep = /^\|?[\s\-:]+\|[\s\-:]+\|?$/.test(trimmed);

    if (isTableRow && !isTableSep) {
      const parts = trimmed.split('|');
      const escaped = parts.map(p => p.replace(/\\\|/g, '|').replace(/\|/g, '\\|')).join('|');
      result.push(escaped);
      continue;
    }

    // Step 1: Embeds ![[file]] - must come before wiki links
    let processed = line.replace(/!\[\[([^\]]+)\]\]/g, (match, file) => {
      const ext = getExt(file);
      if (['.png', '.jpg', '.jpeg', '.gif', '.webp', '.svg'].includes(ext)) {
        return `![${file}](/uploads/${file})`;
      }
      return `[${file}](/uploads/${file})`;
    });

    // Step 2: Wiki links [[Link]] or [[Link|Alias]]
    processed = processed.replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, (match, link, alias) => {
      const text = alias || link;
      const slug = link.toLowerCase().replace(/[^a-z0-9一-龥]+/g, '-').replace(/^-+|-+$/g, '');
      return `[${text}](/post/${slug})`;
    });

    result.push(processed);
  }

  if (inCallout) result.push(...calloutLines);
  return result.join('\n');
}

// Scan & Import button
const scanBtn = document.getElementById('scanBtn');
if (scanBtn) {
  scanBtn.addEventListener('click', async () => {
    scanBtn.disabled = true;
    scanBtn.textContent = '扫描中... · SCANNING...';
    statusDiv.style.display = 'block';
    statusDiv.innerHTML = '<p style="color: var(--fg-dim);">正在扫描 <%= config.import.obsidianDirLabel %> 目录...</p>';

    try {
      const response = await fetch('/admin/import/directory', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        }
      });

      const result = await response.json();

      if (result.success) {
        let html = `
          <p style="color: var(--fg); margin-bottom: 0.5rem;"><strong>扫描完成</strong></p>
          <p style="color: var(--fg-dim); font-size: 0.9rem;">
            成功导入: <strong>${result.imported}</strong> 篇<br>
            失败: <strong>${result.failed}</strong> 篇
          </p>
        `;

        if (result.details.imported.length > 0) {
          html += '<div style="margin-top: 1rem;"><strong style="font-size: 0.85rem; color: var(--fg);">导入的文章:</strong><ul style="margin-top: 0.5rem; padding-left: 1.5rem; color: var(--fg-dim);">';
          html += result.details.imported.map(f => `<li>${esc(f.title)} (${esc(f.slug)})</li>`).join('');
          html += '</ul></div>';
        }

        if (result.details.failed.length > 0) {
          html += '<div style="margin-top: 1rem;"><strong style="font-size: 0.85rem; color: var(--accent);">失败的文件:</strong><ul style="margin-top: 0.5rem; padding-left: 1.5rem; color: var(--accent);">';
          html += result.details.failed.map(f => `<li>${esc(f.filename)}: ${esc(f.error)}</li>`).join('');
          html += '</ul></div>';
        }

        html += '<a href="/admin" class="btn btn-outline btn-sm" style="margin-top: 1rem; display: inline-flex;">→ 返回管理后台</a>';
        statusDiv.innerHTML = html;
      } else {
        statusDiv.innerHTML = `<p style="color: var(--accent);">错误: ${esc(result.error)}</p>`;
      }
    } catch (err) {
      statusDiv.innerHTML = `<p style="color: var(--accent);">扫描失败: ${esc(err.message)}</p>`;
    } finally {
      scanBtn.disabled = false;
      scanBtn.textContent = '扫描经验目录 · SCAN & IMPORT';
    }
  });
}

// Import button
importBtn.addEventListener('click', async () => {
  if (selectedFiles.length === 0) return;

  importBtn.disabled = true;
  importBtn.textContent = '导入中... · IMPORTING...';
  const statusDiv = document.getElementById('importStatus');
  statusDiv.style.display = 'block';
  statusDiv.innerHTML = '<p style="color: var(--fg-dim);">正在处理文件...</p>';

  const files = [];
  for (const file of selectedFiles) {
    const rawContent = await readFileAsText(file);
    const { frontmatter, content: markdown } = parseFrontmatter(rawContent);
    const converted = convertObsidianSyntax(markdown);

    files.push({
      filename: file.name,
      content: converted,
      frontmatter: frontmatter
    });
  }

  try {
    const response = await fetch('/admin/import', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({ files, options: {} })
    });

    const result = await response.json();

    if (result.success) {
      statusDiv.innerHTML = `
        <p style="color: var(--fg); margin-bottom: 0.5rem;"><strong>✓ 导入完成</strong></p>
        <p style="color: var(--fg-dim); font-size: 0.9rem;">
          成功导入: <strong>${result.imported}</strong> 篇<br>
          失败: <strong>${result.failed}</strong> 篇
        </p>
        ${result.details.imported.length > 0 ? '<div style="margin-top: 1rem;"><strong style="font-size: 0.85rem; color: var(--fg);">导入的文章:</strong><ul style="margin-top: 0.5rem; padding-left: 1.5rem; color: var(--fg-dim);">' + result.details.imported.map(f => `<li>${esc(f.title)} (${esc(f.slug)})</li>`).join('') + '</ul></div>' : ''}
        ${result.details.failed.length > 0 ? '<div style="margin-top: 1rem;"><strong style="font-size: 0.85rem; color: var(--accent);">失败的文件:</strong><ul style="margin-top: 0.5rem; padding-left: 1.5rem; color: var(--accent);">' + result.details.failed.map(f => `<li>${esc(f.filename)}: ${esc(f.error)}</li>`).join('') + '</ul></div>' : ''}
        <a href="/admin" class="btn btn-outline btn-sm" style="margin-top: 1rem; display: inline-flex;">→ 返回管理后台</a>
      `;
    } else {
      statusDiv.innerHTML = `<p style="color: var(--accent);">错误: ${esc(result.error)}</p>`;
    }
  } catch (err) {
    statusDiv.innerHTML = `<p style="color: var(--accent);">导入失败: ${esc(err.message)}</p>`;
  } finally {
    importBtn.disabled = false;
    importBtn.textContent = '开始导入 · START IMPORT →';
  }
});
</script>

<%- include('partials/footer') %>
