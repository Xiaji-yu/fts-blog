<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — <%= config.site.shortName %></title>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/vendor/hljs/github-dark.css">
  <link rel="alternate" type="application/rss+xml" title="<%= config.site.name %> · RSS" href="<%= (config.site.url || config.server.publicUrl).replace(/\/+$/, '') %>/feed.xml">
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : title %>">
  <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : config.site.description %>">
  <meta property="og:url" content="<%= typeof ogUrl !== 'undefined' ? ogUrl : ((config.site.url || config.server.publicUrl).replace(/\/+$/, '') + '/') %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= config.site.name %>">
  <meta name="twitter:card" content="summary">
  <% if (typeof headExtra !== 'undefined') { %>
    <%- headExtra %>
  <% } %>
</head>
<body>
  <% if (typeof noSplash === 'undefined' || !noSplash) { %>
  <div id="pageSplash" class="page-splash" aria-hidden="true">
    <div class="page-splash-grid" aria-hidden="true"></div>
    <div class="page-splash-inner">
      <div class="page-splash-brand"><%= typeof splashBrand !== 'undefined' ? splashBrand : config.site.name %></div>
      <div class="page-splash-sub"><%= typeof splashSub !== 'undefined' ? splashSub : config.site.description %></div>
      <div class="page-splash-tagline"><%= typeof splashTagline !== 'undefined' ? splashTagline : config.site.tagline %></div>
      <div class="page-splash-bar-wrap">
        <div class="page-splash-bar" id="splashBar"></div>
      </div>
      <div class="page-splash-meta">
        <span id="splashPercent">0%</span>
        <span class="page-splash-stamp">LOADING</span>
      </div>
    </div>
    <div class="page-splash-n">N</div>
  </div>
  <% } %>
  <div id="scrollProgress" class="scroll-progress" aria-hidden="true"></div>

  <% if (nMark) { %>
  <div class="n-marker">N</div>
  <% } %>

  <% if (typeof wide !== 'undefined' && wide) { %>
  <div class="container-wide">
  <% } else { %>
  <div class="container">
  <% } %>

  <% // Public nav only — admin pages under /admin render their own FTS-ADMIN nav. %>
  <% if (typeof currentPath === 'undefined' || !currentPath.startsWith('/admin')) { %>
  <nav class="nav" aria-label="主导航">
    <a href="/" class="nav-brand">
      <%= config.site.shortName %> · <span class="nav-brand-sub"><%= config.blueprint.prefix %>-LIB</span>
    </a>
    <ul class="nav-links">
      <li><a href="/" class="<%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'active' : '' %>">首页 · INDEX</a></li>
      <li><a href="/posts" class="<%= (typeof currentPath !== 'undefined' && currentPath === '/posts') ? 'active' : '' %>">归档 · ALL</a></li>
      <li><a href="/tags" class="<%= (typeof currentPath !== 'undefined' && (currentPath === '/tags' || currentPath.startsWith('/tag/'))) ? 'active' : '' %>">标签 · TAGS</a></li>
      <li><a href="/search" class="<%= (typeof currentPath !== 'undefined' && currentPath === '/search') ? 'active' : '' %>">搜索 · SEARCH</a></li>
      <li><a href="/feed.xml">RSS</a></li>
    </ul>
  </nav>
  <% } %>
