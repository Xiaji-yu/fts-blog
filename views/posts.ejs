<%- include('partials/header', { title: title, wide: true, splashBrand: '全部图纸', splashSub: 'ALL POSTS', splashTagline: '共 ' + postCount + ' 篇 · ARCHIVE' }) %>

<style>
  .posts-page .post-list-item {
    user-select: none;
    -webkit-user-select: none;
  }
</style>

<div class="homepage-content posts-page">

<div class="title-block">
  <h1 class="main-title">全部图纸</h1>
  <h2 class="sub-title">ALL POSTS</h2>
  <p class="sub-title-en typewriter" id="typewriterLine" data-text="共 <%= postCount %> 篇 · ARCHIVE">共 <%= postCount %> 篇 · ARCHIVE</p>
</div>

<hr class="divider">

<div class="spec-block">
  <p><span class="label">图号</span> <strong><%= config.blueprint.prefix %>-ARCHIVE</strong> · 比例 1:1 · <span class="label">操作</span> <strong>SCROLL / ↑↓</strong></p>
</div>

<div class="drum-viewport" id="drumViewport" tabindex="0" role="listbox" aria-label="文章列表">
  <div class="drum-track" id="drumTrack">
    <% posts.forEach((post, index) => { %>
    <a href="/post/<%= post.id %>" class="drum-item" role="option" data-index="<%= index %>" aria-label="<%= post.title %>">
      <div class="drum-number"><%= String(index + 1).padStart(3, '0') %></div>
      <div class="drum-body">
        <div class="drum-title"><%= post.title %></div>
        <% if (post.title_en) { %><div class="drum-title-en"><%= post.title_en %></div><% } %>
      </div>
      <div class="drum-meta">
        <div><%= new Date(post.created_at).toLocaleDateString('zh-CN') %></div>
        <div class="card-stats">⏱ <%= post.read_time %> MIN · <%= new Intl.NumberFormat('en-US').format(post.view_count) %> VIEWS</div>
      </div>
    </a>
    <% }) %>
  </div>
</div>

<hr class="divider">

<div class="text-center mt-md">
  <a href="/" class="card-link" style="display: inline-flex; border: 1px solid var(--border); padding: 0.5rem 1.2rem; background: rgba(100, 200, 255, 0.05);"><%= config.post.backToIndex %></a>
</div>

</div>

<%- include('partials/footer') %>
