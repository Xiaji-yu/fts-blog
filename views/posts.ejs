<%- include('partials/header', { title: title, wide: true, splashBrand: '图纸数据库', splashSub: 'DRAWING DATABASE', splashTagline: '共 ' + postCount + ' 条记录 · TOTAL RECORDS' }) %>

<style>
  .posts-page .post-list-item {
    user-select: none;
    -webkit-user-select: none;
  }
</style>

<div class="homepage-content posts-page">

<div class="title-block">
  <h1 class="main-title">图纸数据库</h1>
  <h2 class="sub-title">DRAWING DATABASE</h2>
  <p class="sub-title-en typewriter" id="typewriterLine" data-text="共 <%= postCount %> 条记录 · TOTAL RECORDS">共 <%= postCount %> 条记录 · TOTAL RECORDS</p>
</div>

<div class="compass-marker" aria-hidden="true">N</div>

<hr class="divider">

<div class="spec-block">
  <p><span class="label">图号</span> <strong><%= config.blueprint.prefix %>-DB</strong> · 比例 1:1 · <span class="label">系统</span> <strong>SQLITE</strong> · <span class="label">记录</span> <strong><%= postCount %> ROWS</strong></p>
</div>

<div class="blueprint-stamp" aria-hidden="true">
  <span class="stamp-text">图纸数据库</span>
  <span class="stamp-sub">DRAWING DATABASE · REV 0</span>
</div>

<div class="hero-actions">
  <form method="GET" action="/search" class="hero-search" role="search">
    <input type="search" name="q" class="form-input" placeholder="查询图纸 · QUERY DRAWINGS…" aria-label="站内搜索" required>
    <button type="submit" class="btn btn-sm">查询 · QUERY</button>
  </form>
</div>

<div class="drum-viewport" id="drumViewport" tabindex="0" role="listbox" aria-label="图纸数据库">
  <span class="scale-indicator" aria-hidden="true">SCALE 1:1</span>
  <div class="drum-track" id="drumTrack">
    <% posts.forEach((post, index) => { %>
    <a href="/post/<%= post.id %>" class="drum-item" role="option" data-index="<%= index %>" aria-label="<%= post.title %>">
      <div class="drum-number"><%= String(index + 1).padStart(3, '0') %></div>
      <div class="drum-body">
        <div class="drum-title"><%= post.title %></div>
        <% if (post.title_en) { %><div class="drum-title-en"><%= post.title_en %></div><% } %>
      </div>
      <div class="drum-meta">
        <div><%= new Date(post.created_at).toLocaleDateString('zh-CN') %></div>
        <div class="card-stats">⏱ <%= post.read_time %> MIN · <%= new Intl.NumberFormat('en-US').format(post.view_count) %> VIEWS</div>
      </div>
    </a>
    <% }) %>
  </div>
</div>

<div class="blueprint-plate" aria-hidden="true">
  <span class="plate-text">END OF DATABASE</span>
  <span class="plate-sub">— EOF —</span>
</div>

<hr class="divider">

<div class="text-center mt-md">
  <a href="/" class="card-link" style="display: inline-flex; border: 1px solid var(--border); padding: 0.5rem 1.2rem; background: rgba(100, 200, 255, 0.05);"><%= config.post.backToIndex %></a>
</div>

<div class="compass-marker compass-s" aria-hidden="true">S</div>

</div>

<%- include('partials/footer') %>
