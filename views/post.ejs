<%- include('partials/header', { 
  title: title, 
  wide: true, 
  noSplash: true, 
  ogTitle: post.title, 
  ogDescription: post.excerpt || post.title, 
  ogUrl: ((config.site.url || config.server.publicUrl).replace(/\/+$/, '')) + '/post/' + post.id,
  headExtra: '<style>html.drawer-ready .title-block,html.drawer-ready .spec-block,html.drawer-ready .post-layout,html.drawer-ready .post-content-full{opacity:0}</style><script>document.documentElement.classList.add("drawer-ready")</script>'
}) %>

<div id="drawingLoader" class="drawing-loader active" aria-hidden="true">
  <div class="drawing-loader-grid" aria-hidden="true"></div>
  <div class="drawing-loader-inner">
    <div class="drawing-loader-title">图纸 [<%= post.title %>]… 正在加载</div>
    <div class="drawing-loader-sub">DRAWING LOADER</div>
    <div class="drawing-loader-bar-wrap">
      <div class="drawing-loader-bar" id="drawingBar"></div>
    </div>
    <div class="drawing-loader-meta">
      <span id="drawingPercent">0%</span>
      <span class="drawing-loader-stamp">LOADING</span>
    </div>
  </div>
  <div class="drawing-loader-n">N</div>
</div>

<div class="title-block">
  <h1 class="main-title"><%= post.title %></h1>
  <% if (post.title_en) { %>
  <p class="sub-title-en"><%= post.title_en %></p>
  <% } %>
</div>

<hr class="divider">

<div class="spec-block">
  <p><span class="label">图号</span> <strong><%= config.site.drawingPrefix %>-<%= String(post.id).padStart(3, '0') %></strong> · 比例 1:1</p>
  <p><span class="label">日期</span> <strong><%= new Date(post.created_at).toLocaleDateString('zh-CN') %></strong> · 阅读时间 <strong><%= readTime %> min</strong> · 浏览 <strong><%= post.view_count %></strong></p>
</div>

<% if (post.cover_image) { %>
<div class="text-center mb-lg">
  <img src="<%= post.cover_image %>" alt="<%= post.title %>" style="max-width: 100%; border: 1px solid var(--border);">
</div>
<% } %>

<div class="post-layout">
  <aside class="toc-sidebar">
    <div class="toc-title">目录 · CONTENTS</div>
    <nav class="toc-nav" id="tocNav">
      <!-- TOC will be generated by JavaScript -->
    </nav>
  </aside>

  <article class="post-content-full">
    <div class="description post-body" id="postContent">
      <%- marked.parse(post.content) %>
    </div>
  </article>
</div>

<% if (post.tags && post.tags.length > 0) { %>
<div class="card-tags mt-lg">
  <% post.tags.forEach(tag => { %>
  <a href="/tag/<%= encodeURIComponent(tag) %>" class="tag">#<%= tag %></a>
  <% }) %>
</div>
<% } %>

<% if (prevPost || nextPost) { %>
<hr class="divider">
<div class="post-nav" style="display: flex; gap: var(--spacing-md); align-items: stretch; flex-wrap: wrap;">
  <% if (prevPost) { %>
  <a href="/post/<%= prevPost.id %>" class="card-link" style="flex: 1; display: block; border: 1px solid var(--border); padding: 0.6rem 1rem;">
    <span style="font-size: 0.7rem; color: var(--muted); display: block;">← 上一篇 · OLDER</span>
    <%= prevPost.title %>
  </a>
  <% } %>
  <% if (nextPost) { %>
  <a href="/post/<%= nextPost.id %>" class="card-link" style="flex: 1; display: block; text-align: right; border: 1px solid var(--border); padding: 0.6rem 1rem;">
    <span style="font-size: 0.7rem; color: var(--muted); display: block;">下一篇 · NEWER →</span>
    <%= nextPost.title %>
  </a>
  <% } %>
</div>
<% } %>

<hr class="divider">

<div class="text-center mt-md">
  <a href="/" class="card-link" style="display: inline-flex; border: 1px solid var(--border); padding: 0.5rem 1.2rem; background: rgba(100, 200, 255, 0.05);"><%= config.post.backToIndex %></a>
</div>

<script>
(function () {
  var content = document.getElementById('postContent');
  var tocNav = document.getElementById('tocNav');
  if (!content || !tocNav) return;

  var headings = content.querySelectorAll('h2, h3');
  if (headings.length === 0) {
    tocNav.innerHTML = '<div class="toc-empty">暂无章节 · NO SECTIONS</div>';
    return;
  }

  var items = [];
  headings.forEach(function (heading, index) {
    if (!heading.id) heading.id = 'section-' + index;
    var level = heading.tagName.toLowerCase();
    var text = heading.textContent.trim();

    var link = document.createElement('a');
    link.href = '#' + heading.id;
    link.className = 'toc-link toc-link-' + level;
    link.dataset.targetId = heading.id;

    var num = document.createElement('span');
    num.className = 'toc-number';
    num.textContent = String(index + 1).padStart(2, '0');

    var label = document.createElement('span');
    label.className = 'toc-label';
    label.textContent = text;

    link.appendChild(num);
    link.appendChild(label);

    link.addEventListener('click', function (e) {
      e.preventDefault();
      link.classList.add('toc-flash');
      setTimeout(function () { link.classList.remove('toc-flash'); }, 300);
      var el = document.getElementById(heading.id);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    tocNav.appendChild(link);
    items.push({ id: heading.id, link: link, level: level });
  });

  var progress = document.createElement('div');
  progress.className = 'toc-progress';
  tocNav.appendChild(progress);

  function updateProgress() {
    if (!progress || !items.length) return;
    var activeItem = null;
    for (var i = 0; i < items.length; i++) {
      if (items[i].link.classList.contains('active')) {
        activeItem = items[i];
        break;
      }
    }
    if (!activeItem) return;
    var nav = progress.parentElement;
    var navRect = nav.getBoundingClientRect();
    var linkRect = activeItem.link.getBoundingClientRect();
    var top = Math.max(0, linkRect.top - navRect.top + linkRect.height * 0.5);
    progress.style.height = top + 'px';
  }

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        var id = entry.target.id;
        for (var j = 0; j < items.length; j++) {
          items[j].link.classList.toggle('active', items[j].id === id);
        }
        updateProgress();
      }
    });
  }, { rootMargin: '-20% 0px -80% 0px' });

  for (var k = 0; k < headings.length; k++) {
    observer.observe(headings[k]);
  }

  var ticking = false;
  function requestUpdate() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      updateProgress();
      ticking = false;
    });
  }

  window.addEventListener('scroll', requestUpdate, { passive: true });
  window.addEventListener('resize', requestUpdate);
  updateProgress();
})();
</script>

<%- include('partials/footer') %>
