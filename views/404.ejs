<%- include('partials/header', { title: title }) %>

<div class="title-block">
  <h1 class="main-title"><%= config.errors['404'].errorCode %></h1>
  <p class="sub-title-en"><%= config.errors['404'].subtitle %></p>
</div>

<hr class="divider">

<div class="spec-block">
  <p><span class="label">错误</span> <strong><%= config.errors['404'].errorCode %></strong> · <%= config.errors['404'].message %></p>
</div>

<div class="description">
  <p><%= config.errors['404'].body %></p>
  <p class="mt-sm"><%= config.errors['404'].bodyEn %></p>
</div>

<div class="text-center">
  <div class="stamp"><%= config.errors['404'].stamp %></div>
</div>

<div class="text-center mt-lg">
  <a href="/" class="btn">← 返回首页 · BACK TO INDEX</a>
</div>

<%- include('partials/footer') %>
