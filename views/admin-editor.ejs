<%- include('partials/header', { title: title }) %>

<div class="nav">
  <a href="/admin" class="nav-brand"><%= config.admin.navBrand %></a>
  <div>
    <a href="/" class="btn btn-outline btn-sm">← 主页 · HOME</a>
    &nbsp;&nbsp;
    <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted);">
      用户: <strong><%= username %></strong>
    </span>
    &nbsp;&nbsp;
    <form method="POST" action="/admin/logout" style="display: inline;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-outline btn-sm">登出</button>
    </form>
  </div>
</div>

<div class="title-block" style="padding-top: 0;">
  <h1 class="main-title"><%= post ? config.admin.editor.titleEdit : config.admin.editor.titleNew %></h1>
  <p class="sub-title-en"><%= post ? config.admin.editor.titleEditEn : config.admin.editor.titleNewEn %></p>
</div>

<hr class="divider">

<div class="spec-block">
  <p><span class="label">操作</span> <strong><%= post ? 'UPDATE' : 'CREATE' %></strong> · 图号 <strong><%= config.site.drawingPrefix %>-<%= post ? String(post.id).padStart(3, '0') : 'NEW' %></strong></p>
</div>

<div class="editor-panel">
  <div class="panel-header" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
    <span class="panel-title">编辑 · EDITOR</span>
    <button type="button" class="btn btn-outline btn-sm" onclick="toggleLivePreview()">👁 实时预览 · LIVE</button>
  </div>

  <div id="editorSplit" style="display: flex; gap: var(--spacing-lg); align-items: flex-start;">
    <div id="editorFormCol" style="flex: 1; min-width: 0;">
      <div class="description" style="text-align: left; max-width: 100%;">
        <form method="POST" action="<%= post ? '/api/posts/' + post.id : '/api/posts' %>" id="post-form">
          <% if (post) { %>
          <input type="hidden" name="_method" value="PUT">
          <% } %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-group">
              <label class="form-label" for="title"><%= config.admin.editor.labels.title %></label>
              <input type="text" id="title" name="title" class="form-input" value="<%= post ? post.title : '' %>" required>
            </div>

            <div class="form-group">
              <label class="form-label" for="title_en"><%= config.admin.editor.labels.titleEn %></label>
              <input type="text" id="title_en" name="title_en" class="form-input" value="<%= post ? post.title_en || '' : '' %>">
            </div>

            <div class="form-group">
              <label class="form-label" for="slug"><%= config.admin.editor.labels.slug %></label>
              <input type="text" id="slug" name="slug" class="form-input" value="<%= post ? post.slug : '' %>" required pattern="[a-z0-9-]+" title="Only lowercase letters, numbers, and hyphens">
              <small style="color: var(--muted); font-size: 0.8rem; margin-top: 0.25rem; display: block;">
                <%= config.admin.editor.labels.slugHint %>
              </small>
            </div>

            <div class="form-group">
              <label class="form-label" for="excerpt"><%= config.admin.editor.labels.excerpt %></label>
              <input type="text" id="excerpt" name="excerpt" class="form-input" value="<%= post ? post.excerpt || '' : '' %>" maxlength="200">
            </div>

            <div class="form-group">
              <label class="form-label" for="content"><%= config.admin.editor.labels.content %></label>
              <textarea id="content" name="content" class="form-textarea" rows="18" required><%= post ? post.content : '' %></textarea>
            </div>

            <div class="form-group">
              <label class="form-label" for="tags"><%= config.admin.editor.labels.tags %></label>
              <input type="text" id="tags" name="tags" class="form-input" value="<%= post ? post.tags : '' %>" placeholder="技术, 前端, JavaScript">
            </div>

            <div class="form-group">
              <label class="form-label" style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                <input type="checkbox" name="published" <%= post && post.published ? 'checked' : '' %> style="width: auto;">
                <span><%= config.admin.editor.labels.published %></span>
              </label>
            </div>

            <div style="display: flex; gap: var(--spacing-sm); flex-wrap: wrap;">
              <button type="button" class="btn btn-outline" onclick="previewPost()">
                <%= config.admin.editor.buttons.preview %>
              </button>
              <button type="button" class="btn btn-outline" onclick="openImageLibrary()">🖼 图片库 · IMAGES</button>
              <button type="submit" class="btn">
                <%= post ? config.admin.editor.buttons.update : config.admin.editor.buttons.create %>
              </button>
              <a href="/admin" class="btn btn-outline"><%= config.admin.editor.buttons.cancel %></a>
              <a href="/admin/import" class="btn btn-outline" style="font-size: 0.75rem;">📥 导入Obsidian</a>
            </div>
          </form>
        </div>
      </div>
      <div id="livePreview" class="description" style="flex: 1; min-width: 0; text-align: left; max-width: 100%; display: none; border: 1px solid var(--border); padding: var(--spacing-md); max-height: 70vh; overflow-y: auto;">
        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); letter-spacing: 0.06em; margin-bottom: var(--spacing-sm);">LIVE PREVIEW · 实时预览</div>
      </div>
    </div>
  </div>
</div>

<!-- Image Library Modal -->
<div id="image-modal" class="modal-overlay" style="display: none;">
  <div class="modal-content" style="max-width: 760px;">
    <div class="modal-header">
      <h3>图片库 · Image Library</h3>
      <button class="modal-close" onclick="closeImageLibrary()">&times;</button>
    </div>
    <div style="padding: var(--spacing-sm) 0; display: flex; gap: var(--spacing-sm); align-items: center; flex-wrap: wrap;">
      <input type="file" id="image-upload-input" accept="image/*" style="display: none;">
      <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('image-upload-input').click()">⬆ 上传图片 · UPLOAD</button>
      <span id="image-upload-status" style="font-size: 0.8rem; color: var(--muted);"></span>
    </div>
    <div id="image-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: var(--spacing-sm); max-height: 50vh; overflow-y: auto;">
      <p style="color: var(--muted); grid-column: 1 / -1;">加载中…</p>
    </div>
  </div>
</div>

<script src="/vendor/marked/marked.min.js"></script>
<script src="/vendor/dompurify/purify.min.js"></script>
<script>
function getCsrf() {
  const meta = document.querySelector('meta[name="csrf-token"]');
  return meta ? meta.content : '';
}

// ---------- Save (create / update) ----------
document.getElementById('post-form').addEventListener('submit', async function(e) {
  e.preventDefault();

  const form = e.target;
  const formData = new FormData(form);
  const isEdit = <%= post ? 'true' : 'false' %>;
  const url = isEdit ? '/api/posts/<%= post ? post.id : '' %>' : '/api/posts';
  const method = isEdit ? 'PUT' : 'POST';

  const data = {};
  formData.forEach((value, key) => {
    if (key === '_csrf' || key === '_method') return;
    if (key === 'tags') {
      data[key] = value;
    } else if (key === 'published') {
      data[key] = true;
    } else {
      data[key] = value;
    }
  });

  try {
    const response = await fetch(url, {
      method: method,
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': getCsrf()
      },
      body: JSON.stringify(data)
    });

    if (response.ok) {
      window.location.href = '/admin';
    } else {
      const result = await response.json();
      alert('操作失败 · Failed: ' + (result.error || 'Unknown error'));
    }
  } catch (err) {
    alert('网络错误 · Network error: ' + err.message);
  }
});

// ---------- Preview in new window ----------
function previewPost() {
  const form = document.getElementById('post-form');
  const formData = new FormData(form);
  const data = {};
  formData.forEach((value, key) => {
    if (key !== '_csrf' && key !== '_method') data[key] = value;
  });

  fetch('/admin/preview', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': getCsrf()
    },
    body: JSON.stringify(data)
  }).then(response => {
    if (response.ok) return response.text();
    throw new Error('Preview failed: ' + response.status);
  }).then(html => {
    const previewWindow = window.open('', '_blank', 'width:1400,height:900');
    if (previewWindow) {
      previewWindow.document.write(html);
      previewWindow.document.close();
    } else {
      alert('无法打开预览窗口，请检查浏览器弹窗拦截设置');
    }
  }).catch(err => {
    alert('预览失败: ' + err.message);
    console.error(err);
  });
}

// ---------- Live split preview ----------
const contentTa = document.getElementById('content');
const livePreview = document.getElementById('livePreview');
let livePreviewVisible = false;
let previewTimer = null;

function renderLivePreview() {
  if (!livePreviewVisible) return;
  const value = contentTa ? contentTa.value : '';
  if (typeof marked !== 'undefined' && typeof DOMPurify !== 'undefined') {
    livePreview.innerHTML = DOMPurify.sanitize(marked.parse(value || ''));
  } else {
    livePreview.textContent = value || '';
  }
}

function toggleLivePreview() {
  livePreviewVisible = !livePreviewVisible;
  livePreview.style.display = livePreviewVisible ? 'block' : 'none';
  if (livePreviewVisible) renderLivePreview();
}

if (contentTa) {
  contentTa.addEventListener('input', () => {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(renderLivePreview, 300);
  });
}

// ---------- Image library ----------
const imageModal = document.getElementById('image-modal');
const imageList = document.getElementById('image-list');
const imageUploadInput = document.getElementById('image-upload-input');

function openImageLibrary() {
  imageModal.style.display = 'flex';
  loadUploads();
}

function closeImageLibrary() {
  imageModal.style.display = 'none';
}

function insertAtCursor(text) {
  if (!contentTa) return;
  const start = contentTa.selectionStart || contentTa.value.length;
  contentTa.setRangeText(text, start, start, 'end');
  contentTa.focus();
  renderLivePreview();
}

async function loadUploads() {
  imageList.innerHTML = '<p style="color: var(--muted); grid-column: 1 / -1;">加载中…</p>';
  try {
    const response = await fetch('/api/uploads', { headers: { 'X-CSRF-Token': getCsrf() } });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Failed to load');
    if (data.uploads.length === 0) {
      imageList.innerHTML = '<p style="color: var(--muted); grid-column: 1 / -1;">暂无图片，点击上方按钮上传。</p>';
      return;
    }
    imageList.innerHTML = data.uploads.map(img => `
      <div style="border: 1px solid var(--border); padding: 0.4rem; text-align: center; background: var(--bg-card);">
        <img src="${img.url}" alt="${img.name}" style="max-width: 100%; height: 80px; object-fit: contain; display: block; margin: 0 auto 0.4rem;">
        <div style="font-size: 0.65rem; color: var(--muted); word-break: break-all; margin-bottom: 0.4rem;">${img.name}</div>
        <div style="display: flex; gap: 0.3rem; justify-content: center;">
          <button type="button" class="btn btn-outline btn-sm" onclick="insertImage('${img.url.replace(/'/g, "\\'")}', '${img.name.replace(/'/g, "\\'")}')">插入 · INSERT</button>
          <button type="button" class="btn btn-danger btn-sm" onclick="deleteImage('${img.name.replace(/'/g, "\\'")}')">删除 · DEL</button>
        </div>
      </div>`).join('');
  } catch (err) {
    imageList.innerHTML = '<p style="color: var(--accent); grid-column: 1 / -1;">加载失败: ' + err.message + '</p>';
  }
}

function insertImage(url, name) {
  const ext = (name.split('.').pop() || '').toLowerCase();
  const isImage = ['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg'].includes(ext);
  insertAtCursor(isImage ? `![${name}](${url})` : `[${name}](${url})`);
}

async function deleteImage(name) {
  if (!confirm('确定删除图片「' + name + '」？\n\nDelete this image?')) return;
  try {
    const response = await fetch('/api/uploads/' + encodeURIComponent(name), {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': getCsrf() }
    });
    if (response.ok) {
      loadUploads();
    } else {
      const data = await response.json();
      alert('删除失败 · Delete failed: ' + (data.error || 'Unknown error'));
    }
  } catch (err) {
    alert('网络错误 · Network error: ' + err.message);
  }
}

imageUploadInput.addEventListener('change', async () => {
  const file = imageUploadInput.files[0];
  if (!file) return;
  const status = document.getElementById('image-upload-status');
  status.textContent = '上传中…';
  const formData = new FormData();
  formData.append('image', file);
  try {
    const response = await fetch('/api/upload', {
      method: 'POST',
      headers: { 'X-CSRF-Token': getCsrf() },
      body: formData
    });
    const data = await response.json();
    if (response.ok) {
      status.textContent = '✓ 上传成功';
      imageUploadInput.value = '';
      loadUploads();
      insertAtCursor(`![${data.filename}](${data.path})`);
    } else {
      status.textContent = '✗ ' + (data.error || 'Upload failed');
    }
  } catch (err) {
    status.textContent = '✗ ' + err.message;
  }
});

imageModal.addEventListener('click', function(e) {
  if (e.target === this) closeImageLibrary();
});
</script>

<%- include('partials/footer') %>
